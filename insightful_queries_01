//finds most common card type for fraud
SELECT "card4", COUNT(*) AS frequency
FROM train_transactions_table
WHERE "isFraud" = TRUE
GROUP BY "card4"
ORDER BY frequency DESC;

//lists card brand types (visa, mastercard, etc) that were fraud versus not fraud and lists percentage
SELECT 
    "card4",
    COUNT(*) FILTER (WHERE "isFraud" = TRUE) AS fraud_count,
    COUNT(*) FILTER (WHERE "isFraud" = FALSE) AS non_fraud_count,
    ROUND(100.0 * COUNT(*) FILTER (WHERE "isFraud" = TRUE) / COUNT(*), 2) AS fraud_percentage
FROM train_transactions_table
GROUP BY "card4"
ORDER BY fraud_percentage DESC;

//same as above for credit versus debit
SELECT 
    "card6",
    COUNT(*) FILTER (WHERE "isFraud" = TRUE) AS fraud_count,
    COUNT(*) FILTER (WHERE "isFraud" = FALSE) AS non_fraud_count,
    ROUND(100.0 * COUNT(*) FILTER (WHERE "isFraud" = TRUE) / COUNT(*), 2) AS fraud_percentage
FROM train_transactions_table
GROUP BY "card6"
ORDER BY fraud_percentage DESC;

//average money spent versus total money spent for fraud and not fraud
SELECT 
    CASE 
        WHEN "isFraud" = TRUE THEN 'Fraudulent'
        WHEN "isFraud" = FALSE THEN 'Non-Fraudulent'
    END AS fraud_status,
    AVG("TransactionAmt") AS avg_transaction_amt,
    SUM("TransactionAmt") AS total_transaction_amt
FROM train_transactions_table
GROUP BY fraud_status;
